# Firebase web configuration. These are public client configuration values,
# but the project must have Anonymous Authentication and Firestore enabled.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Add GEMINI_API_KEY only when the server-side extraction route is implemented.
# Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=
