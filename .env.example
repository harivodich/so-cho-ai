# Firebase web configuration. These are public client configuration values,
# but the project must have Anonymous Authentication and Firestore enabled.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Vercel-only server secret: the complete one-line JSON of a least-privilege
# Firebase/Google service account. Do not prefix with NEXT_PUBLIC_ or commit it.
# Cloud Run and local ADC can leave this empty.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Server-only Gemini configuration for POST /api/extract.
# Never prefix these with NEXT_PUBLIC_ or commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional, used only by evaluation/scripts/generate-tts-audio.mjs.
# Generated synthetic WAV files are ignored by Git.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
