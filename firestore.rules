rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function validString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function ownsDocument(userId) {
      return signedInAs(userId)
        && request.resource.data.userId == userId
        && request.resource.data.keys().size() <= 30;
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read: if signedInAs(userId);
      allow create, update: if ownsDocument(userId)
        && validNumber(request.resource.data.amount, 0, 1000000000000)
        && (request.resource.data.type in ['sale', 'purchase', 'expense'])
        && validString(request.resource.data.itemName, 200)
        && (request.resource.data.get('unitPrice', null) == null || validNumber(request.resource.data.unitPrice, 0, 1000000000000))
        && (request.resource.data.get('quantity', null) == null || validNumber(request.resource.data.quantity, 0, 10000000));
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/profile/{document=**} {
      allow read: if signedInAs(userId);
      allow write: if signedInAs(userId)
        && request.resource.data.keys().size() <= 20
        && (request.resource.data.get('displayName', null) == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && (request.resource.data.get('phone', null) == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && (request.resource.data.get('email', null) == null || (request.resource.data.email is string && request.resource.data.email.size() <= 200));
    }

    match /users/{userId}/debts/{debtId} {
      allow read: if signedInAs(userId);
      allow create, update: if ownsDocument(userId)
        && validNumber(request.resource.data.amount, 0, 1000000000000)
        && (request.resource.data.type in ['receivable', 'payable'])
        && validString(request.resource.data.counterpartyName, 200);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/products/{productId} {
      allow read: if signedInAs(userId);
      allow create, update: if ownsDocument(userId)
        && validString(request.resource.data.name, 200)
        && (request.resource.data.get('unit', null) == null || (request.resource.data.unit is string && request.resource.data.unit.size() <= 50));
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/stockMovements/{movementId} {
      allow read: if signedInAs(userId);
      allow create, update: if ownsDocument(userId)
        && validNumber(request.resource.data.quantity, 0, 10000000);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/counterparties/{counterpartyId} {
      allow read: if signedInAs(userId);
      allow create, update: if ownsDocument(userId)
        && validString(request.resource.data.name, 200);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/settings/{document=**} {
      allow read: if signedInAs(userId);
      allow write: if signedInAs(userId)
        && request.resource.data.keys().size() <= 20
        && (request.resource.data.get('revenueGoals', null) == null || request.resource.data.revenueGoals is map);
    }

    match /idempotency_records/{recordId} {
      allow read, write: if false; // Server-only Admin SDK access
    }
  }
}
