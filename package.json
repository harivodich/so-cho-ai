{
  "name": "so-cho-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:text:fixture": "node evaluation/scripts/generate-text-fixture.mjs && node evaluation/scripts/run-text-eval.mjs --fixture evaluation/fixtures/text-eval-perfect.jsonl",
    "eval:text": "node evaluation/scripts/run-text-eval.mjs",
    "eval:text:publish": "node evaluation/scripts/run-text-eval.mjs && node evaluation/scripts/publish-text-report.mjs",
    "eval:metrics": "node evaluation/scripts/test-metrics.mjs",
    "verify:evidence": "node evaluation/scripts/verify-evidence.mjs",
    "smoke:public": "node scripts/public-smoke.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^14.2.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
